{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "thehenrylabs-web",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "thehenrylabs.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
